# ============================================================
# TailWell — example environment file (NAMES ONLY, no secrets)
# Copy to .env for local tooling if needed; .env is gitignored.
# Real values live ONLY in: n8n (Credentials + Settings/Environment)
# and your local shell — never in this repository.
# Names below are the ones the current workflow/checklist actually
# use; placeholders inside the workflow JSON are listed too so
# nothing gets invented twice.
# ============================================================

# --- n8n environment variables (n8n -> Settings -> Environment) ---
# Consumed by the workflow as $env.AUTOPILOT_ENABLED / $env.WORDPRESS_URL
AUTOPILOT_ENABLED=false
WORDPRESS_URL=

# --- Model names: literal strings inside n8n/tailwell-end-to-end.json
# (replace in the JSON before import; names kept as the workflow uses them) ---
OLLAMA_LOCAL_MODEL=
OPENROUTER_MODEL_FOR_WRITING=
OPENROUTER_MODEL_FOR_QA=
# optional; workflow reuses the writing model when unset
OPENROUTER_MODEL_FOR_SEO=

# --- Placeholders that live INSIDE the workflow JSON (replace there) ---
YOUR_TELEGRAM_CHAT_ID=
YOUR_SHEET_PUBLISHED_CSV_URL=

# --- Credentials (configure in n8n -> Credentials UI; values never committed) ---
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_API_KEY=
WORDPRESS_USERNAME=tw-automation
WORDPRESS_APP_PASSWORD=
# Gemini image stage is NOT wired yet (docs/image-pipeline.md, Phase 10)
GEMINI_API_KEY=
